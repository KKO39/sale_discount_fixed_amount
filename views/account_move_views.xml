<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="after">
                <field name="discount_amount" optional="show"/>
            </xpath>
            
        </field>
    </record>

</odoo>
